+    def set_refusal_lambda(self, value: float) -> float:
+        """Fija lambda de la proyeccion rank-1 en ESTE rank. Se invoca por
+        collective_rpc, igual que sleep/wake_up.
+
+        Con el executor `mp` y TP=2, cambiar lambda en el proceso del head NO
+        llega al worker: hay que ir por collective_rpc a todos los ranks. Cada
+        rank devuelve el valor que aplico para que el llamante confirme que los
+        dos coinciden antes de dar OK.
+
+        La mutacion es in-place sobre el tensor en device (`fill_`), asi que es
+        segura con los grafos CUDA ya capturados.
+        """
+        from vllm.refusal_projection import set_lambda
+
+        applied = set_lambda(float(value))
+        logger.info("refusal lambda = %s (rank %s)", applied, self.rank)
+        return applied
+
+    def get_refusal_lambda(self) -> float:
+        """Lee lambda de ESTE rank. Tambien por collective_rpc: el frontend no
+        comparte proceso con los workers, asi que su copia local no vale como
+        fuente de verdad."""
+        from vllm.refusal_projection import get_lambda
+
+        return get_lambda()
