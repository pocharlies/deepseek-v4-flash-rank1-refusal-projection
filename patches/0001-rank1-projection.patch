diff -uNr src/v1/worker/gpu/refusal_utils.py src-patched/v1/worker/gpu/refusal_utils.py
--- src/v1/worker/gpu/refusal_utils.py	1970-01-01 01:00:00.000000000 +0100
+++ src-patched/v1/worker/gpu/refusal_utils.py	2026-08-12 18:43:01.828978513 +0200
@@ -0,0 +1,70 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Estado por peticion del lambda de la proyeccion rank-1, para el Model Runner V2.
+
+POR QUE EXISTE ESTE FICHERO: el parche original solo toco
+`v1/worker/gpu_model_runner.py`, que es el runner **V1**. Este despliegue arranca
+con el **V2** (`gpu_worker.py` loguea "Using V2 Model Runner"), que vive en el
+paquete `v1/worker/gpu/`. Resultado: el tensor por token nunca se construia y el
+hook caia siempre al lambda global — el dial global funcionaba y la seleccion por
+peticion no hacia absolutamente nada, en silencio.
+
+Esta calcado de `LoraState` (lora_utils.py), que resuelve el mismo problema:
+un valor por peticion que hay que expandir a por token con el mismo
+`idx_mapping` / `num_scheduled_tokens` del lote.
+"""
+
+from __future__ import annotations
+
+import numpy as np
+import torch
+
+# NaN = la peticion no trajo lambda propio -> usa el global del servidor.
+NO_LAMBDA = np.nan
+
+
+class RefusalState:
+    def __init__(self, max_num_reqs: int, max_num_tokens: int, device: torch.device):
+        self.lambdas = np.full(max_num_reqs, NO_LAMBDA, dtype=np.float32)
+        # Buffer PERSISTENTE: con grafos CUDA el puntero se hornea en la captura,
+        # asi que no puede ser una asignacion nueva por paso. Se crea fuera de
+        # inference_mode por la misma razon que el tensor de lambda global: un
+        # tensor nacido en inference mode no admite mutacion in-place despues.
+        with torch.inference_mode(False):
+            self._buf = torch.zeros(max_num_tokens, dtype=torch.float32, device=device)
+
+    def add_request(self, req_index: int, refusal_lambda: float | None) -> None:
+        self.lambdas[req_index] = NO_LAMBDA if refusal_lambda is None else refusal_lambda
+
+    def remove_request(self, req_index: int) -> None:
+        # El slot se reutiliza; dejarlo limpio evita que una peticion nueva herede
+        # el modo de la anterior si algun camino no llamara a add_request.
+        self.lambdas[req_index] = NO_LAMBDA
+
+    def make_token_lambdas(
+        self,
+        idx_mapping: np.ndarray,
+        num_scheduled_tokens: np.ndarray,
+        global_lambda: float,
+        num_tokens_padded: int,
+    ) -> torch.Tensor:
+        """Vista [num_tokens_padded] del buffer con el lambda de cada token.
+
+        `num_tokens_padded` NO es opcional y es el detalle que costo dos ciclos de
+        build: el forward corre sobre `batch_desc.num_tokens`, que viene PADEADO
+        para los grafos CUDA (model_runner.py: is_padding[num_tokens:
+        num_tokens_after_padding]). Devolver un tensor del tamano real hace que no
+        cuadre con `y` en el hook, y el hook caia al lambda global en silencio.
+
+        Las filas de padding se rellenan con el lambda global: da igual lo que
+        lleven porque se descartan, pero no pueden quedar sin inicializar.
+        """
+        lam = self.lambdas[idx_mapping]
+        lam = np.where(np.isnan(lam), np.float32(global_lambda), lam)
+        tok = np.repeat(lam, num_scheduled_tokens)
+        n = int(tok.shape[0])
+        assert n <= num_tokens_padded, (n, num_tokens_padded)
+        with torch.inference_mode(False):
+            self._buf[:n].copy_(torch.from_numpy(tok), non_blocking=True)
+            if num_tokens_padded > n:
+                self._buf[n:num_tokens_padded].fill_(float(global_lambda))
+        return self._buf[:num_tokens_padded]
